{
  "name": "orange-music-desktop",
  "productName": "Orange Music",
  "version": "1.8.0",
  "description": "Orange Music 音乐播放器 Windows 桌面版（本地 + 在线）",
  "main": "main.js",
  "author": "Andjuzhi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaojuzhi/Orange-Music.git"
  },
  "homepage": "https://github.com/xiaojuzhi/Orange-Music#readme",
  "bugs": {
    "url": "https://github.com/xiaojuzhi/Orange-Music/issues"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "install:local": "node scripts/install-local.js",
    "dist:install": "npm run dist && npm run install:local",
    "publish:github": "node scripts/publish.js"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.orange.music",
    "productName": "Orange Music",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/**",
      "online/**",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
