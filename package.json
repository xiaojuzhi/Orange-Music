{
  "name": "orange-music-desktop",
  "productName": "Orange Music",
  "version": "1.6.9",
  "description": "Orange Music 音乐播放器 Windows 桌面版（本地 + 在线）",
  "main": "main.js",
  "author": "Orange Music",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "set \"ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/\" && set \"ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/\" && electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.orange.music.desktop",
    "productName": "Orange Music",
    "asar": false,
    "artifactName": "Orange-Music-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "online/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orange Music"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0"
  }
}
